# Copy file này thành ".env" rồi sửa lại cho đúng máy của bạn

# Chuỗi kết nối PostgreSQL: postgresql://<user>:<mật khẩu>@<máy chủ>:<cổng>/<tên database>
DATABASE_URL="postgresql://hrapp:hrapp@localhost:5432/hr_kpi?schema=public"

# Khóa bí mật để ký cookie đăng nhập — PHẢI đổi khi chạy thật, dài ít nhất 32 ký tự
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="dev-only-change-me-to-a-long-random-string-0123456789"

# Khi chạy bản production qua http (chưa có https, ví dụ http://192.168.1.10:3000) thì bật dòng này,
# nếu không trình duyệt sẽ không lưu cookie đăng nhập
# INSECURE_COOKIE=1

# Cổng PostgreSQL trên máy host khi chạy bằng docker compose (mặc định 5432)
# DB_PORT=5433

# Import chấm công: tháng bắt đầu áp dụng (mặc định 2027-01). Đặt sớm hơn để demo, ví dụ:
# ATTENDANCE_START_MONTH=2026-06
